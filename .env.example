# Скопируйте в .env и поправьте под свою машину:
#
#   cp .env.example .env
#
# Файл .env закрыт в .gitignore: настоящие пароли и токены живут только в нём.

# Где лежит снимок данных. Относительный путь считается от корня проекта.
PRIME_DATA_DIR=data

# Токен Telegram-бота. В практикуме не нужен, понадобится в итоговом проекте.
TELEGRAM_TOKEN=
